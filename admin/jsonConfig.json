{
    "i18n": true,
    "type": "tabs",
    "items": {
        "_settings": {
            "type": "panel",
            "label": "Settings",
            "items": {
                "_logo": {
                    "type": "staticImage",
                    "src": "panasonic-viera.png",
                    "style": {
                        "width": "64px"
                    },
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "ip": {
                    "newLine": true,
                    "type": "autocompleteSendTo",
                    "label": "IP",
                    "command": "discover",
                    "freeSolo": true,
                    "maxLength": 15,
                    "help": "TVs found in the network are offered for selection (the instance must be running)",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "app_id": {
                    "newLine": true,
                    "type": "text",
                    "label": "Application ID",
                    "help": "Application ID (for encryption)",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                },
                "encryption_key": {
                    "newLine": true,
                    "type": "text",
                    "label": "Encryption Key",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 4,
                    "xl": 4
                }
            }
        },
        "_remote": {
            "type": "panel",
            "label": "Remote control",
            "items": {
                "_remoteControl": {
                    "type": "custom",
                    "url": "custom/customComponents.js",
                    "name": "ConfigCustomPanasonicVieraSet/Components/RemoteControlComponent",
                    "i18n": true,
                    "guiApi": 2,
                    "bundlerType": "module",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                }
            }
        }
    }
}
